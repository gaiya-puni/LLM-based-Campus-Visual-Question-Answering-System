# Copy this file to .env for local development. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=
MAX_CONTENT_LENGTH=1048576

# 大模型服务商：deepseek（默认）或 chatecnu，两者都是 OpenAI 兼容接口。
# 只读取所选服务商的三个变量；选中的服务商没配密钥时会明确返回"AI 服务尚未配置"，
# 不会自动切换到另一个服务商。后端启动时会在控制台打印当前生效的服务商与模型名。
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 改用华东师范大学 ChatECNU 时：把上面的 LLM_PROVIDER 改成 chatecnu，并填写下面三项。
CHATECNU_API_KEY=replace-with-your-key
CHATECNU_API_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
CHATECNU_MODEL=ecnu-plus

LLM_HTTP_PROXY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=test
MYSQL_CHARSET=utf8mb4

SPARK_APP_ID=replace-with-your-app-id
SPARK_API_SECRET=replace-with-your-secret
SPARK_API_KEY=replace-with-your-key

# Web service key used only by backend data conversion scripts.
AMAP_WEB_SERVICE_KEY=replace-with-your-web-service-key
