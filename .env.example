# Copy this file to .env for local development. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=
# 请求体上限（字节）。图片链路需要能容纳"最多 2 张、单张 4MB"（base64 约 4/3 膨胀），
# 因此默认值已抬高到 12MB；调小会让上传大图直接返回 413。
# MAX_CONTENT_LENGTH=12582912

# 大模型服务商：deepseek（默认）或 chatecnu，两者都是 OpenAI 兼容接口。
# 只读取所选服务商的三个变量；选中的服务商没配密钥时会明确返回"AI 服务尚未配置"，
# 不会自动切换到另一个服务商。后端启动时会在控制台打印当前生效的服务商与模型名。
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# 改用华东师范大学 ChatECNU 时：把上面的 LLM_PROVIDER 改成 chatecnu，并填写下面三项。
CHATECNU_API_KEY=replace-with-your-key
CHATECNU_API_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
CHATECNU_MODEL=ecnu-plus

LLM_HTTP_PROXY=

# 图片理解（多模态）。默认**关闭**：deepseek-chat 等纯文本模型收到图片会直接报错，
# 后端不会静默借用它。要启用"上传照片问地点"，二选一：
#   1) 配一组独立的视觉模型（推荐）——只需 VISION_API_KEY，URL/模型名默认沿用上面的服务商；
#   2) 确认当前服务商本身就是多模态，设 VISION_ENABLED=true。
# 未启用时，问答会如实回答"本部署未启用图片理解"，前端上传入口仍可见但会提示不可用。
VISION_ENABLED=auto
# VISION_API_KEY=replace-with-your-vision-key
# VISION_API_URL=https://api.deepseek.com/v1/chat/completions
# VISION_MODEL=qwen-vl-max
# VISION_LABEL=Vision

# 本地句向量检索；索引或依赖缺失时 auto 会自动回退到关键词规则。
SEMANTIC_ENABLED=auto
SEMANTIC_MODEL_PATH=BAAI/bge-small-zh-v1.5
SEMANTIC_INDEX_FILE=semantic_index.npz
SEMANTIC_INDEX_META_FILE=semantic_index_meta.json

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=test
MYSQL_CHARSET=utf8mb4

SPARK_APP_ID=replace-with-your-app-id
SPARK_API_SECRET=replace-with-your-secret
SPARK_API_KEY=replace-with-your-key

# Backend-only Web service key for campus discovery, POI collection, and conversion.
# Never put this key in frontend source code or VITE_* variables.
AMAP_WEB_SERVICE_KEY=replace-with-your-web-service-key

# AMap POI collection throttling and retry tuning; defaults are usually sufficient.
# AMAP_REQUEST_INTERVAL_SECONDS=0.25
# AMAP_MAX_RETRIES=2
# AMAP_RETRY_BACKOFF_SECONDS=0.5
# AMAP_EMPTY_CACHE_TTL_SECONDS=300

# 出站代理（通常不用配）。默认行为：
#   - 高德 Web 服务：**直连**。Windows 的系统代理（Clash 等注册到注册表）会让
#     restapi.amap.com 全部 ProxyError，表现为"高德采集一条都拿不到"。
#   - 公开网页与 Tavily/Brave：**沿用系统代理设置**（境外站点在受限网络下常需代理）。
# 确有需要时取消注释显式指定；高德要走代理就填 AMAP_HTTP_PROXY。
# AMAP_HTTP_PROXY=http://127.0.0.1:7897
# WEB_HTTP_PROXY=http://127.0.0.1:7897

# 自动发现公开网页：tavily（默认、开通较快）或 brave。只填写所选服务商的 Key；
# Key 仅由 Flask 后端读取，不能写进前端代码。搜索只发现候选 URL，页面仍经过
# HTTPS/公网地址/类型/大小限制并进入人工审核。
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-with-your-tavily-key
BRAVE_SEARCH_API_KEY=replace-with-your-brave-key
# WEB_SEARCH_MAX_RESULTS=10
# WEB_SEARCH_PER_DOMAIN_LIMIT=2
# WEB_SEARCH_MAX_QUERIES=2
# WEB_SEARCH_TIMEOUT=8

# 用户共建数据（消息反馈 / 地点上报 / 未收录地点抽取，见 webapp/backend/USER_DATA_PIPELINE.md）
# 审核密钥：至少 16 位；**不配置时所有审核接口返回 403**，前端"数据审核"页会给出开启说明。
# 同时决定「评论审核」入口是否出现：配好并重启后端后，侧栏与移动端"更多"里才会显示该页；
# 队友要用同一页时，把这一串密钥口头/私下告知他们，他们首次打开页面粘贴一次即可（只存本机 localStorage）。
USERDATA_REVIEW_TOKEN=replace-with-a-local-secret-at-least-16-chars
# 校园资产生成器仅支持单进程本地运行；以下参数限制并发与保留任务总量。
# CAMPUS_BUILD_WORKERS=2
# CAMPUS_BUILD_MAX_PENDING=16
# CAMPUS_BUILD_MAX_JOBS=256
# 采集总开关：设为 0/false/off 可整体关闭未收录采集（默认开启）。
# USERDATA_CAPTURE=1
# 大模型抽取模式：batch（默认，在线零调用，交给审核页批量研判）或 inline（未收录时当场判一次）。
# USERDATA_LLM_EXTRACT=batch
# 用户共建数据目录（默认 webapp/backend/userdata，已被 .gitignore 忽略）。
# USERDATA_DIR=
